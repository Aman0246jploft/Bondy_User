{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/buttons/**",
              "components/cards/**",
              "components/display/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "ui_kits/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sansation|Inter|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Sansation, Inter, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|state|size|label|key|ref|className|style|children)$/]",
        "message": "<Arrow> doesn't accept that prop. Declared props: direction, state, size, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right|up|down)$/]",
        "message": "<Arrow> direction must be one of 'left' | 'right' | 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|disabled)$/]",
        "message": "<Arrow> state must be one of 'default' | 'disabled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:weight|size|key|ref|className|style|children)$/]",
        "message": "<ArrowRight> doesn't accept that prop. Declared props: weight, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowRight'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:regular|bold|fill)$/]",
        "message": "<ArrowRight> weight must be one of 'regular' | 'bold' | 'fill'."
      },
